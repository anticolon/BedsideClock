void loadAlarmSettings() {
  prefs.begin("alarm", true);
  alarmHour    = prefs.getInt("hour", 7);
  alarmMinute  = prefs.getInt("min", 0);
  alarmEnabled = prefs.getBool("enabled", false);
  alarmSound   = prefs.getString("sound", "");
  alarmVolume  = prefs.getInt("vol", 50);
  snoozeDuration = prefs.getInt("snooze", 5);
  schedEnabled = prefs.getBool("schedOn", false);
  schedStored  = prefs.getBytes("sched", sched, sizeof(sched)) == sizeof(sched);
  for (int d = 0; d < 7; d++) {
    if (!schedStored || sched[d].hour > 23 || sched[d].min > 59) sched[d] = { 0, (uint8_t)alarmHour, (uint8_t)alarmMinute };
    char key[6]; snprintf(key, sizeof(key), "snd%d", d);
    schedSound[d] = prefs.getString(key, "");
  }
  skipTarget = (time_t)prefs.getLong64("skip", 0);
  prefs.end();
}
void saveAlarmSettings() {
  prefs.begin("alarm", false);
  prefs.putInt("hour", alarmHour);
  prefs.putInt("min", alarmMinute);
  prefs.putBool("enabled", alarmEnabled);
  prefs.putString("sound", alarmSound);
  prefs.putInt("vol", alarmVolume);
  prefs.putInt("snooze", snoozeDuration);
  prefs.end();
}
void saveSchedule() {
  prefs.begin("alarm", false);
  prefs.putBool("schedOn", schedEnabled);
  prefs.putBytes("sched", sched, sizeof(sched));
  for (int d = 0; d < 7; d++) {
    char key[6]; snprintf(key, sizeof(key), "snd%d", d);
    prefs.putString(key, schedSound[d]);
  }
  prefs.putLong64("skip", (int64_t)skipTarget);
  prefs.end();
  schedStored = true;
}

// ==========================================================================
//  SD Card init & MP3 file scanner
// ==========================================================================
void rescanMP3Files() {
  mp3FileCount = 0;
  if (!sdCardOk) return;
  File root = SD.open("/");
  if (root) {
    File f = root.openNextFile();
    while (f && mp3FileCount < 32) {
      String name = String(f.name());
      if (!f.isDirectory() && (name.endsWith(".mp3") || name.endsWith(".MP3"))) {
        if (!name.startsWith("/")) name = "/" + name;
        mp3Files[mp3FileCount++] = name;
      }
      f = root.openNextFile();
    }
    root.close();
  }
  logMsg("Rescan: found %d MP3 files\n", mp3FileCount);

  // If no alarm sound is selected (or selected file was deleted), auto-select the first one
  if (mp3FileCount > 0 && (alarmSound.length() == 0 || !SD.exists(alarmSound.c_str()))) {
    alarmSound = mp3Files[0];
    saveAlarmSettings();
    logMsg("Auto-selected alarm sound: %s\n", alarmSound.c_str());
  }
}

void initSDCard() {
  SPI.begin(LCD_SCK, SD_MISO, LCD_MOSI, SD_CS);
  if (SD.begin(SD_CS)) {
    sdCardOk = true;
    logMsg("SD card mounted\n");
    rescanMP3Files();
  } else {
    sdCardOk = false;
    logMsg("SD card mount failed\n");
  }
}

