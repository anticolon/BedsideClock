// ==========================================================================
//  Audio playback
// ==========================================================================
#define ALARM_MIN_VOLUME  10   // a ringing alarm is never quieter than this (%)

void applyVolume() {
  int v = alarmVolume;
  if (alarmFiring && v < ALARM_MIN_VOLUME) v = ALARM_MIN_VOLUME;
  if (audioOut) audioOut->SetGain((float)v / 100.0f);
}

// ==========================================================================
//  Fallback alarm tone — used when the MP3 can't be played (no SD card,
//  missing or broken file), so a ringing alarm is never silent.
//  Invariant: I2S is running iff (mp3Player is playing) or toneActive.
//  AudioOutputI2S::begin() asserts if the channel already exists, so the tone
//  only starts after stopAlarmSound() has released the MP3 player.
// ==========================================================================
#define TONE_RATE        16000   // samples/s
#define TONE_HALF_PERIOD 4       // samples → 2 kHz square wave
#define TONE_AMPLITUDE   12000
static bool     toneActive = false;
static uint32_t toneSample = 0;

void stopAlarmSound();

void stopFallbackTone() {
  if (!toneActive) return;
  audioOut->stop();
  toneActive = false;
  applyVolume();
}

void startFallbackTone() {
  if (toneActive || !audioOut) return;
  stopAlarmSound();  // releases any MP3 player (and its I2S channel)
  audioOut->SetChannels(2);
  audioOut->SetRate(TONE_RATE);
  int v = alarmVolume < 30 ? 30 : alarmVolume;
  audioOut->SetGain((float)v / 100.0f);
  if (!audioOut->begin()) return;
  toneActive = true;
  toneSample = 0;
  audioPlaying = true;
  logMsg("Alarm: MP3 unavailable, playing fallback tone\n");
}

// Feed the I2S DMA without blocking: "beep-beep" (120 ms on/off) once a second
void loopFallbackTone() {
  if (!toneActive) return;
  for (int n = 0; n < 1024; n++) {
    uint32_t ms = (toneSample % TONE_RATE) * 1000UL / TONE_RATE;  // position within the 1 s pattern
    bool on = (ms < 120) || (ms >= 240 && ms < 360);
    int16_t v = on ? (((toneSample / TONE_HALF_PERIOD) & 1) ? TONE_AMPLITUDE : -TONE_AMPLITUDE) : 0;
    int16_t smp[2] = { v, v };
    if (!audioOut->ConsumeSample(smp)) break;  // DMA full — continue next loop
    toneSample++;
  }
}

// Alarm MP3 that dies right after starting (corrupt file) → switch to the tone
static uint32_t alarmMp3StartedAt = 0;
static int      alarmMp3QuickEnds = 0;

void initAudio() {
  audioOut = new AudioOutputI2S();
  audioOut->SetPinout(I2S_BCLK, I2S_LRC, I2S_DOUT);
  applyVolume();
}

void startAlarmSound() {
  alarmMp3QuickEnds = 0;
  if (!sdCardOk || firingSound.length() == 0) { startFallbackTone(); return; }
  stopAlarmSound();
  applyVolume();
  playingFile = firingSound;
  mp3Source = new AudioFileSourceSD(playingFile.c_str());
  mp3Buffer = new AudioFileSourceBuffer(mp3Source, 2048);
  mp3Player = new AudioGeneratorMP3();
  if (mp3Player->begin(mp3Buffer, audioOut)) {
    audioPlaying = true;
    alarmMp3StartedAt = millis();
    logMsg("Alarm playing: %s\n", playingFile.c_str());
  } else {
    logMsg("Failed to start MP3\n");
    delete mp3Player; mp3Player = nullptr;
    delete mp3Buffer; mp3Buffer = nullptr;
    delete mp3Source; mp3Source = nullptr;
    startFallbackTone();
  }
}

void stopAlarmSound() {
  if (mp3Player) {
    if (mp3Player->isRunning()) mp3Player->stop();
    delete mp3Player; mp3Player = nullptr;
  }
  if (mp3Buffer) {
    delete mp3Buffer; mp3Buffer = nullptr;
  }
  if (mp3Source) {
    delete mp3Source; mp3Source = nullptr;
  }
  stopFallbackTone();
  audioPlaying = false;
  testPlaying = false;
}

void startTestSound() {
  if (!sdCardOk || alarmSound.length() == 0) return;
  stopAlarmSound();
  applyVolume();
  playingFile = alarmSound;
  mp3Source = new AudioFileSourceSD(playingFile.c_str());
  mp3Buffer = new AudioFileSourceBuffer(mp3Source, 2048);
  mp3Player = new AudioGeneratorMP3();
  if (mp3Player->begin(mp3Buffer, audioOut)) {
    audioPlaying = true;
    testPlaying = true;
    logMsg("Test playing: %s at %d%%\n", alarmSound.c_str(), alarmVolume);
  } else {
    logMsg("Failed to start test MP3\n");
    delete mp3Player; mp3Player = nullptr;
    delete mp3Buffer; mp3Buffer = nullptr;
    delete mp3Source; mp3Source = nullptr;
  }
}

void stopTestSound() {
  stopAlarmSound();
}

void loopAudio() {
  // First, process any commands queued by async web handlers
  if (audioReqTestStop) {
    audioReqTestStop = false;
    stopTestSound();
  }
  if (audioReqDismiss) {
    audioReqDismiss = false;
    dismissAlarm();
  }
  if (audioReqTestStart) {
    audioReqTestStart = false;
    startTestSound();
  }
  if (audioReqVolume) {
    audioReqVolume = false;
    applyVolume();
  }

  loopFallbackTone();

  if (mp3Player && mp3Player->isRunning()) {
    if (!mp3Player->loop()) {
      // MP3 ended — clean up
      mp3Player->stop();
      delete mp3Player; mp3Player = nullptr;
      delete mp3Buffer; mp3Buffer = nullptr;
      delete mp3Source; mp3Source = nullptr;
      if (alarmFiring) {
        // Restart loop for alarm — unless the file keeps ending immediately
        // (corrupt/unreadable), then fall back to the built-in tone
        if (millis() - alarmMp3StartedAt < 1500) alarmMp3QuickEnds++;
        else alarmMp3QuickEnds = 0;
        if (alarmMp3QuickEnds >= 3) {
          audioPlaying = false;
          startFallbackTone();
          return;
        }
        delay(50);  // brief pause before restarting
        mp3Source = new AudioFileSourceSD(playingFile.c_str());
        mp3Buffer = new AudioFileSourceBuffer(mp3Source, 2048);
        mp3Player = new AudioGeneratorMP3();
        if (mp3Player->begin(mp3Buffer, audioOut)) {
          alarmMp3StartedAt = millis();
          logMsg("Alarm MP3 looping...\n");
        } else {
          logMsg("Failed to restart alarm MP3\n");
          delete mp3Player; mp3Player = nullptr;
          delete mp3Buffer; mp3Buffer = nullptr;
          delete mp3Source; mp3Source = nullptr;
          audioPlaying = false;
          startFallbackTone();
        }
      } else {
        // Test or other — just stop
        audioPlaying = false;
        testPlaying = false;
      }
    }
  }
}

// ==========================================================================
//  Alarm check (called every loop iteration in clock mode)
// ==========================================================================
// Fires during the alarm minute, and also catches up if the alarm moment was
// passed since the previous check (loop paused by an upload or a long blocking
// call, or the clock jumped forward, e.g. DST), up to ALARM_CATCHUP_MIN late.
// No catch-up on the first check after boot.
#define ALARM_CATCHUP_MIN 60

// Alarm time for weekday wd (0 = Sunday); false if no alarm that day
bool alarmForDay(int wd, int &h, int &m) {
  if (!schedEnabled) { h = alarmHour; m = alarmMinute; return alarmEnabled; }
  h = sched[wd].hour; m = sched[wd].min;
  return sched[wd].on;
}

// Alarm moment on the date dayOffset days from `now` (negative = past), 0 if none
time_t alarmOnDay(const struct tm &now, int dayOffset, int *wdOut) {
  struct tm t = now;
  t.tm_mday += dayOffset;
  t.tm_hour = 12; t.tm_min = 0; t.tm_sec = 0; t.tm_isdst = -1;
  mktime(&t);  // normalise the date and get its weekday
  int h, m;
  if (!alarmForDay(t.tm_wday, h, m)) return 0;
  t.tm_hour = h; t.tm_min = m; t.tm_isdst = -1;
  if (wdOut) *wdOut = t.tm_wday;
  return mktime(&t);
}

// Next alarm moment after now, 0 if none. withSkipped = false passes over a skipped one.
time_t nextAlarm(bool withSkipped, int *wdOut) {
  struct tm ti;
  if (!getLocalTime(&ti, 0)) return 0;
  time_t now = mktime(&ti);
  for (int d = 0; d <= 7; d++) {
    time_t c = alarmOnDay(ti, d, wdOut);
    if (c > now && (withSkipped || c != skipTarget)) return c;
  }
  return 0;
}

// "Tue 06:30" for the next alarm that will ring, "--:--" if none
void nextAlarmStr(char *buf, int len) {
  int wd = 0;
  time_t t = nextAlarm(false, &wd);
  if (!t) { snprintf(buf, len, "--:--"); return; }
  struct tm lt; localtime_r(&t, &lt);
  snprintf(buf, len, "%s %02d:%02d", dayNames[wd], lt.tm_hour, lt.tm_min);
}

// A skip that no longer matches the next alarm (schedule edited) is dropped
void schedDropStaleSkip() {
  if (skipTarget && (!schedEnabled || nextAlarm(true, nullptr) != skipTarget)) skipTarget = 0;
}

void checkAlarm() {
  static time_t lastCheck = 0;

  struct tm ti;
  if (!getLocalTime(&ti, 0)) return;
  time_t now = mktime(&ti);
  time_t prev = lastCheck ? lastCheck : now;
  lastCheck = now;  // track even while disarmed, so arming never fires retroactively

  // Schedule label names the next alarm: refresh it once a minute (also after NTP sync)
  static time_t lastLabelMin = 0;
  if (schedEnabled && now / 60 != lastLabelMin && !alarmFiring && !alarmSnoozing) {
    lastLabelMin = now / 60;
    updateAlarmLabel();
  }

  if (alarmFiring || alarmSnoozing) return;

  // Most recent alarm moment: today's, or yesterday's (with yesterday's settings)
  int wd = 0;
  time_t target = 0;
  for (int d = 0; d >= -1 && !target; d--) {
    time_t c = alarmOnDay(ti, d, &wd);
    if (c && c <= now) target = c;
  }

  // A skip whose moment passed long ago (clock was off) is dropped
  if (skipTarget && now - skipTarget > ALARM_CATCHUP_MIN * 60) {
    skipTarget = 0;
    saveSchedule();
  }

  if (!target || target == lastFiredTarget) return;
  bool inAlarmMinute = (now - target < 60);
  bool passedSinceLastCheck = (target > prev && now - target <= ALARM_CATCHUP_MIN * 60);
  if (!inAlarmMinute && !passedSinceLastCheck) return;

  lastFiredTarget = target;
  if (schedEnabled && target == skipTarget) {
    skipTarget = 0;
    saveSchedule();
    updateAlarmLabel();
    logMsg("Alarm skipped (%s)\n", dayNames[wd]);
    return;
  }

  // Tune: the day's own song if it still exists, else the default tune
  firingSound = alarmSound;
  if (schedEnabled && schedSound[wd].length() && sdCardOk && SD.exists(schedSound[wd].c_str()))
    firingSound = schedSound[wd];

  alarmFiring = true;
  if (!schedEnabled) {
    alarmEnabled = false;  // one-shot: disable after firing
    saveAlarmSettings();
  }
  currentAlarmMsg = alarmMessages[random(NUM_ALARM_MESSAGES)];
  startAlarmSound();
  updateAlarmLabel();
  logMsg("ALARM TRIGGERED! (%s)\n", schedEnabled ? dayNames[wd] : "single");
}

void dismissAlarm() {
  if (!alarmFiring && !alarmSnoozing) return;
  alarmFiring = false;
  alarmSnoozing = false;
  snoozeEndTime = 0;
  stopAlarmSound();
  updateAlarmLabel();
  logMsg("Alarm dismissed\n");
}

void snoozeAlarm() {
  if (!alarmFiring) return;
  stopAlarmSound();
  alarmFiring = false;
  alarmSnoozing = true;
  snoozeEndTime = millis() + (unsigned long)snoozeDuration * 60UL * 1000UL;
  updateAlarmLabel();
  logMsg("Snoozing for %d minutes\n", snoozeDuration);
}

void checkSnooze() {
  if (!alarmSnoozing) return;
  if ((long)(millis() - snoozeEndTime) >= 0) {  // wrap-safe (millis() rolls over every ~49.7 days)
    // Snooze expired — alarm fires again
    alarmSnoozing = false;
    alarmFiring = true;
    startAlarmSound();
    updateAlarmLabel();
    logMsg("Snooze ended - alarm firing again!\n");
  }
}

void updateAlarmLabel() {
  if (!label_alarm || menuActive) return;  // menuClose() → showClockUI() refreshes it
  if (alarmFiring) {
    lv_label_set_text(label_alarm, currentAlarmMsg);
    lv_obj_set_style_text_color(label_alarm, lv_color_hex(0xFFCC44), 0);
    lv_obj_set_pos(label_alarm, 0, (gfx->height() / 2) + 34);  // quotes shifted up
    lv_obj_clear_flag(label_alarm, LV_OBJ_FLAG_HIDDEN);
  } else if (alarmSnoozing) {
    // Show countdown
    unsigned long remaining = 0;
    long left = (long)(snoozeEndTime - millis());  // wrap-safe
    if (left > 0) remaining = left;
    int secLeft = remaining / 1000;
    int m = secLeft / 60;
    int s = secLeft % 60;
    char buf[24];
    snprintf(buf, sizeof(buf), "Snooze: %d:%02d", m, s);
    lv_label_set_text(label_alarm, buf);
    lv_obj_set_style_text_color(label_alarm, lv_color_hex(0x7CCFFF), 0);
    lv_obj_set_pos(label_alarm, 0, (gfx->height() / 2) + 44);  // original position
    lv_obj_clear_flag(label_alarm, LV_OBJ_FLAG_HIDDEN);
  } else if (schedEnabled ? nextAlarm(false, nullptr) != 0 : alarmEnabled) {
    char buf[24];
    if (schedEnabled) {
      char nb[12]; nextAlarmStr(nb, sizeof(nb));
      snprintf(buf, sizeof(buf), "Alarm: %s", nb);
    } else {
      snprintf(buf, sizeof(buf), "Alarm: %02d:%02d", alarmHour, alarmMinute);
    }
    lv_label_set_text(label_alarm, buf);
    lv_obj_set_style_text_color(label_alarm, lv_color_hex(0xFF3333), 0);
    lv_obj_set_pos(label_alarm, 0, (gfx->height() / 2) + 44);  // original position
    lv_obj_clear_flag(label_alarm, LV_OBJ_FLAG_HIDDEN);
  } else {
    lv_obj_add_flag(label_alarm, LV_OBJ_FLAG_HIDDEN);
  }
}

// ==========================================================================
//  Rotary Encoder reading (rotation via ISR, button polled here)
// ==========================================================================
#define ENC_SW_DEBOUNCE_MS 20

void readEncoder() {
  // Button state (polled — no need for ISR on a slow human press).
  // Debounced: a new level only counts once it has been stable for
  // ENC_SW_DEBOUNCE_MS, so contact bounce can't produce double presses.
  static bool rawLevel = false;
  static uint32_t rawSince = 0;
  bool raw = (digitalRead(ENC_SW) == LOW);
  if (raw != rawLevel) {
    rawLevel = raw;
    rawSince = millis();
  }
  if (millis() - rawSince < ENC_SW_DEBOUNCE_MS) return;

  bool pressed = rawLevel;
  if (pressed && !encSwPressed) {
    encSwDownTime = millis();
    encSwHandled = false;
    encLongHandled = false;
  }
  encSwPressed = pressed;
}

// Consume rotation delta (returns whole detent clicks, resets remainder)
// Full quadrature decode gives 4 state changes per EC11 detent.
// We accumulate and only emit complete detents.
static int encAccum = 0;
#define ENC_COUNTS_PER_DETENT 4

int consumeEncoderDelta() {
  noInterrupts();
  int raw = encDelta;
  encDelta = 0;
  interrupts();
  encAccum += raw;
  int detents = encAccum / ENC_COUNTS_PER_DETENT;
  encAccum %= ENC_COUNTS_PER_DETENT;  // keep remainder
  return detents;
}

// Check for short press (returns true once on release after <1s hold)
bool encoderShortPress() {
  if (!encSwPressed && !encSwHandled && encSwDownTime > 0 && !encLongHandled) {
    encSwHandled = true;
    encSwDownTime = 0;
    return true;
  }
  return false;
}

// Check for long press (returns true once after 1s hold while still pressed)
bool encoderLongPress() {
  if (encSwPressed && !encLongHandled && encSwDownTime > 0) {
    if (millis() - encSwDownTime >= MENU_HOLD_MS) {
      encLongHandled = true;
      return true;
    }
  }
  return false;
}

// ==========================================================================
//  On-screen Menu system
// ==========================================================================
void menuGetValueStr(int item, char *buf, int bufLen) {
  switch (item) {
    case 0: { // Brightness
      int pct = cfgBrightness * 100 / 255;
      snprintf(buf, bufLen, "%d%%", pct);
    } break;
    case 1: // Wake up (schedule: next alarm, read-only)
      if (schedEnabled) nextAlarmStr(buf, bufLen);
      else snprintf(buf, bufLen, "%02d:%02d", alarmHour, alarmMinute);
      break;
    case 2: // Alarm (schedule: skip the next alarm)
      if (schedEnabled) snprintf(buf, bufLen, "%s", skipTarget ? "Skip" : (nextAlarm(true, nullptr) ? "On" : "Off"));
      else snprintf(buf, bufLen, "%s", alarmEnabled ? "On" : "Off");
      break;
    case 3: snprintf(buf, bufLen, "%d min", snoozeDuration); break; // Snooze
    case 4: { // Tune
      if (alarmSound.length() == 0) snprintf(buf, bufLen, "(none)");
      else {
        const char *s = alarmSound.c_str();
        if (s[0] == '/') s++;
        snprintf(buf, bufLen, "%s", s);
      }
    } break;
    case 5: snprintf(buf, bufLen, "%d%%", alarmVolume); break; // Volume
    case 6: snprintf(buf, bufLen, "%s", testPlaying ? "Stop" : "Play"); break; // Test
    case 7: snprintf(buf, bufLen, "%s", webEnabled ? "On" : "Off"); break; // Webpage
  }
}

void hideClockUI() {
  if (label_time) lv_obj_add_flag(label_time, LV_OBJ_FLAG_HIDDEN);
  if (label_date) lv_obj_add_flag(label_date, LV_OBJ_FLAG_HIDDEN);
  if (label_alarm) lv_obj_add_flag(label_alarm, LV_OBJ_FLAG_HIDDEN);
  if (label_temp) lv_obj_add_flag(label_temp, LV_OBJ_FLAG_HIDDEN);
  if (label_hilo) lv_obj_add_flag(label_hilo, LV_OBJ_FLAG_HIDDEN);
  if (weather_icon_img) lv_obj_add_flag(weather_icon_img, LV_OBJ_FLAG_HIDDEN);
  if (label_status) lv_obj_add_flag(label_status, LV_OBJ_FLAG_HIDDEN);
  if (boot_bar) lv_obj_add_flag(boot_bar, LV_OBJ_FLAG_HIDDEN);
  if (boot_bar_label) lv_obj_add_flag(boot_bar_label, LV_OBJ_FLAG_HIDDEN);
}

void showClockUI() {
  if (label_time) lv_obj_clear_flag(label_time, LV_OBJ_FLAG_HIDDEN);
  if (label_date) lv_obj_clear_flag(label_date, LV_OBJ_FLAG_HIDDEN);
  if (label_temp) lv_obj_clear_flag(label_temp, LV_OBJ_FLAG_HIDDEN);
  if (label_hilo) lv_obj_clear_flag(label_hilo, LV_OBJ_FLAG_HIDDEN);
  if (weather_icon_img) lv_obj_clear_flag(weather_icon_img, LV_OBJ_FLAG_HIDDEN);
  if (label_status) lv_obj_clear_flag(label_status, LV_OBJ_FLAG_HIDDEN);
  updateAlarmLabel();  // will show/hide based on alarm state
}

void buildMenuUI() {
  lv_obj_t *scr = lv_scr_act();

  // Hide clock elements so they don't bleed through
  hideClockUI();

  // Full-screen overlay
  menuContainer = lv_obj_create(scr);
  lv_obj_remove_style_all(menuContainer);
  lv_obj_set_size(menuContainer, gfx->width(), gfx->height());
  lv_obj_set_pos(menuContainer, 0, 0);
  lv_obj_set_style_bg_color(menuContainer, lv_color_black(), 0);
  lv_obj_set_style_bg_opa(menuContainer, LV_OPA_COVER, 0);
  lv_obj_clear_flag(menuContainer, LV_OBJ_FLAG_SCROLLABLE);

  // Layout: 6 rows × 22px = 132px, centered vertically in 172px
  int rowH = 20;
  int totalH = MENU_ITEMS * rowH;
  int yStart = (gfx->height() - totalH) / 2 - 8 + 5;
  int leftX = 12;
  int valX = 120;   // value column start (after longest label "Brightness:")
  int valW = gfx->width() - valX - 8;  // ~192px for values

  for (int i = 0; i < MENU_ITEMS; i++) {
    int y = yStart + i * rowH;

    // Label: "Name:"
    menuItemLabels[i] = lv_label_create(menuContainer);
    char lbl[32];
    snprintf(lbl, sizeof(lbl), "  %s:", menuLabels[i]);
    lv_label_set_text(menuItemLabels[i], lbl);
    lv_obj_set_style_text_font(menuItemLabels[i], &lv_font_montserrat_14, 0);
    lv_obj_set_style_text_color(menuItemLabels[i], lv_color_hex(0x888888), 0);
    lv_obj_set_pos(menuItemLabels[i], leftX, y);

    // Value
    menuValueLabels[i] = lv_label_create(menuContainer);
    char vBuf[32]; menuGetValueStr(i, vBuf, sizeof(vBuf));
    lv_label_set_text(menuValueLabels[i], vBuf);
    lv_obj_set_style_text_font(menuValueLabels[i], &lv_font_montserrat_14, 0);
    lv_obj_set_style_text_color(menuValueLabels[i], lv_color_white(), 0);
    lv_obj_set_style_text_align(menuValueLabels[i], LV_TEXT_ALIGN_RIGHT, 0);
    lv_obj_set_width(menuValueLabels[i], valW);
    lv_label_set_long_mode(menuValueLabels[i], LV_LABEL_LONG_DOT);
    lv_obj_set_pos(menuValueLabels[i], valX, y);
  }

  // Hint at bottom
  lv_obj_t *hint = lv_label_create(menuContainer);
  lv_label_set_text(hint, "Hold to exit");
  lv_obj_set_style_text_font(hint, &lv_font_montserrat_10, 0);
  lv_obj_set_style_text_color(hint, lv_color_hex(0x333333), 0);
  lv_obj_align(hint, LV_ALIGN_BOTTOM_MID, 0, -2);

  menuCursor = 0;
  menuEditing = false;
  menuEditSub = 0;
  updateMenuHighlight();
}

void destroyMenuUI() {
  if (menuContainer) {
    lv_obj_del(menuContainer);
    menuContainer = NULL;
  }
  for (int i = 0; i < MENU_ITEMS; i++) {
    menuItemLabels[i] = NULL;
    menuValueLabels[i] = NULL;
  }
}

void updateMenuHighlight() {
  for (int i = 0; i < MENU_ITEMS; i++) {
    if (!menuItemLabels[i]) continue;
    bool selected = (i == menuCursor);
    bool editing = selected && menuEditing;

    // Build label text with cursor indicator
    char lbl[32];
    snprintf(lbl, sizeof(lbl), "%s %s:", selected ? ">" : " ", menuLabels[i]);
    lv_label_set_text(menuItemLabels[i], lbl);

    // Label color: selected = cyan, normal = grey
    lv_obj_set_style_text_color(menuItemLabels[i],
      selected ? lv_color_hex(0x7CCFFF) : lv_color_hex(0x888888), 0);

    // Value color: editing = green, selected = white, normal = grey
    if (editing) {
      lv_obj_set_style_text_color(menuValueLabels[i], lv_color_hex(0x44FF44), 0);
    } else if (selected) {
      lv_obj_set_style_text_color(menuValueLabels[i], lv_color_white(), 0);
    } else {
      lv_obj_set_style_text_color(menuValueLabels[i], lv_color_hex(0x666666), 0);
    }
  }
}

void updateMenuValue(int item) {
  if (!menuValueLabels[item]) return;
  char vBuf[32]; menuGetValueStr(item, vBuf, sizeof(vBuf));
  lv_label_set_text(menuValueLabels[item], vBuf);
}

void menuOpen() {
  if (menuActive) return;
  consumeEncoderDelta();  // drop rotation made on the clock screen
  encAccum = 0;
  menuActive = true;
  buildMenuUI();
  logMsg("Menu opened\n");
}

void menuClose() {
  if (!menuActive) return;
  // Leaving with a long press while editing: keep (and persist) the new value
  if (menuEditing) {
    if (menuCursor == 0) saveLocationSettings();
    if (menuCursor >= 1 && menuCursor <= 5) saveAlarmSettings();
  }
  menuActive = false;
  menuEditing = false;
  if (testPlaying) stopTestSound();
  destroyMenuUI();
  showClockUI();
  logMsg("Menu closed\n");
}

void menuHandleInput() {
  if (!menuActive) return;

  int delta = consumeEncoderDelta();

  if (menuEditing) {
    // Editing mode: rotate changes value, press confirms
    if (delta != 0) {
      switch (menuCursor) {
        case 0: { // Brightness
          cfgBrightness += delta * 15;
          if (cfgBrightness < 5) cfgBrightness = 5;
          if (cfgBrightness > 255) cfgBrightness = 255;
          applyBrightness();
          updateMenuValue(0);
        } break;
        case 1: { // Wake up time
          if (menuEditSub == 0) {
            alarmHour += delta;
            if (alarmHour < 0) alarmHour = 23;
            if (alarmHour > 23) alarmHour = 0;
          } else {
            alarmMinute += delta;
            if (alarmMinute < 0) alarmMinute = 59;
            if (alarmMinute > 59) alarmMinute = 0;
          }
          char tbuf[16];
          if (menuEditSub == 0)
            snprintf(tbuf, sizeof(tbuf), "[%02d]:%02d", alarmHour, alarmMinute);
          else
            snprintf(tbuf, sizeof(tbuf), "%02d:[%02d]", alarmHour, alarmMinute);
          lv_label_set_text(menuValueLabels[1], tbuf);
        } break;
        case 3: { // Snooze duration
          snoozeDuration += delta;
          if (snoozeDuration < 1) snoozeDuration = 1;
          if (snoozeDuration > 30) snoozeDuration = 30;
          updateMenuValue(3);
        } break;
        case 4: { // Tune — cycle through MP3 files
          if (mp3FileCount > 0) {
            int cur = -1;
            for (int i = 0; i < mp3FileCount; i++) {
              if (mp3Files[i] == alarmSound) { cur = i; break; }
            }
            cur += delta;
            if (cur < 0) cur = mp3FileCount - 1;
            if (cur >= mp3FileCount) cur = 0;
            alarmSound = mp3Files[cur];
            updateMenuValue(4);
          }
        } break;
        case 5: { // Volume
          alarmVolume += delta * 5;
          if (alarmVolume < 0) alarmVolume = 0;
          if (alarmVolume > 100) alarmVolume = 100;
          applyVolume();
          updateMenuValue(5);
        } break;
      }
    }

    if (encoderShortPress()) {
      if (menuCursor == 1 && menuEditSub == 0) {
        // Move to minute field
        menuEditSub = 1;
        char tbuf[16];
        snprintf(tbuf, sizeof(tbuf), "%02d:[%02d]", alarmHour, alarmMinute);
        lv_label_set_text(menuValueLabels[1], tbuf);
      } else {
        // Done editing
        menuEditing = false;
        menuEditSub = 0;
        updateMenuValue(menuCursor);
        updateMenuHighlight();
        // Save
        if (menuCursor == 0) saveLocationSettings();
        if (menuCursor >= 1 && menuCursor <= 5) saveAlarmSettings();
      }
    }
  } else {
    // Navigation mode: rotate moves cursor, press enters/acts
    if (delta != 0) {
      menuCursor += delta;
      if (menuCursor < 0) menuCursor = MENU_ITEMS - 1;
      if (menuCursor >= MENU_ITEMS) menuCursor = 0;
      updateMenuHighlight();
    }

    if (encoderShortPress()) {
      switch (menuCursor) {
        case 2: {
          // Alarm: instant toggle, no edit mode. Schedule: skip / unskip the next alarm.
          if (schedEnabled) {
            skipTarget = skipTarget ? 0 : nextAlarm(true, nullptr);
            saveSchedule();
            updateMenuValue(1);
            logMsg("Schedule: %s next alarm\n", skipTarget ? "skip" : "keep");
          } else {
            alarmEnabled = !alarmEnabled;
            saveAlarmSettings();
          }
          updateMenuValue(2);
        } break;
        case 6: {
          // Test: instant toggle test sound
          if (testPlaying) { stopTestSound(); } else { startTestSound(); }
          updateMenuValue(6);
        } break;
        case 7: {
          // Webpage: instant toggle
          webEnabled = !webEnabled;
          updateMenuValue(7);
          saveLocationSettings();
        } break;
        default: {
          if (menuCursor == 1 && schedEnabled) break;  // schedule times are set on the web page
          // Enter edit mode for other items
          menuEditing = true;
          menuEditSub = 0;
          updateMenuHighlight();
          if (menuCursor == 1) {
            char tbuf[16];
            snprintf(tbuf, sizeof(tbuf), "[%02d]:%02d", alarmHour, alarmMinute);
            lv_label_set_text(menuValueLabels[1], tbuf);
          }
        } break;
      }
    }
  }

  // Long press always exits menu
  if (encoderLongPress()) {
    menuClose();
  }
}

// ==========================================================================
//  LVGL Flush
// ==========================================================================
static void my_disp_flush(lv_disp_drv_t *disp, const lv_area_t *area, lv_color_t *color_p)
{
  // Skip display SPI transfer during file upload to avoid SPI bus contention
  // (LCD and SD card share the same SPI bus)
  if (uploadInProgress) {
    lv_disp_flush_ready(disp);
    return;
  }
  uint32_t w = area->x2 - area->x1 + 1;
  uint32_t h = area->y2 - area->y1 + 1;
#if LV_COLOR_16_SWAP
  gfx->draw16bitBeRGBBitmap(area->x1, area->y1, (uint16_t *)&color_p->full, w, h);
#else
  gfx->draw16bitRGBBitmap(area->x1, area->y1, (uint16_t *)&color_p->full, w, h);
#endif
  lv_disp_flush_ready(disp);
}

