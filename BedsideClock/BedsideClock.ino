// ==========================================================================
//  Chunked upload state — shared by the /files/upload body handler (AsyncTCP
//  task) and the idle watchdog in loop(). Guarded by uploadMutex.
// ==========================================================================
#define UPLOAD_BUF_SIZE         32768   // max body size of one chunk request
#define UPLOAD_IDLE_TIMEOUT_MS  20000   // abort upload if no data arrives for this long

static SemaphoreHandle_t uploadMutex = nullptr;
static File     uploadFile;
static String   uploadFilename;
static size_t   uploadBytesWritten  = 0;
static size_t   uploadExpectedTotal = 0;
static uint8_t *uploadBuf           = nullptr;  // RAM buffer for one chunk
static size_t   uploadBufPos        = 0;
static bool     uploadChunkSkip     = false;    // chunk was already written (client retry)
static int      uploadStatus        = 200;      // HTTP status for the current chunk request
static const char *uploadStatusMsg  = "OK";
static String   uploadLastDoneName;             // last completed upload (to ack a retried final chunk)
static size_t   uploadLastDoneSize  = 0;

// Close the upload, optionally delete the partial file, free the buffer.
// Caller must hold uploadMutex.
static void uploadCleanupLocked(bool removePartial, const char *reason) {
  if (uploadFile) uploadFile.close();
  uploadFile = File();
  if (removePartial && uploadFilename.length() > 0 && sdCardOk) {
    SD.remove(uploadFilename.c_str());
  }
  if (reason) logMsg("Upload aborted (%s): %s\n", reason, uploadFilename.c_str());
  if (uploadBuf) { free(uploadBuf); uploadBuf = nullptr; }
  uploadBufPos = 0;
  uploadBytesWritten = 0;
  uploadExpectedTotal = 0;
  uploadFilename = "";
  uploadInProgress = false;
}

static void uploadFailLocked(int status, const char *msg, bool abortUpload) {
  uploadStatus = status;
  uploadStatusMsg = msg;
  if (abortUpload && uploadInProgress) uploadCleanupLocked(true, msg);
  else logMsg("Upload: %s\n", msg);
}

// Called from loop(): abort an upload whose client went away.
void uploadIdleWatchdog() {
  if (!uploadInProgress || !uploadMutex) return;
  if (millis() - uploadLastActivity < UPLOAD_IDLE_TIMEOUT_MS) return;
  if (xSemaphoreTake(uploadMutex, 0) != pdTRUE) return;  // body handler busy — try next loop
  if (uploadInProgress && millis() - uploadLastActivity >= UPLOAD_IDLE_TIMEOUT_MS) {
    uploadCleanupLocked(true, "timed out");
    reqRescanMP3 = true;
  }
  xSemaphoreGive(uploadMutex);
}

// URL-decode, strip path/illegal characters, require .mp3. Returns "" if unusable.
static String sanitizeUploadName(const String &raw) {
  String decoded;
  for (unsigned int i = 0; i < raw.length(); i++) {
    if (raw[i] == '%' && i + 2 < raw.length()) {
      char hex[3] = { raw[i+1], raw[i+2], 0 };
      decoded += (char)strtol(hex, NULL, 16);
      i += 2;
    } else {
      decoded += raw[i];
    }
  }
  String out;
  for (unsigned int i = 0; i < decoded.length(); i++) {
    char c = decoded[i];
    if ((uint8_t)c < 0x20 || strchr("/\\:*?\"<>|", c)) continue;
    out += c;
  }
  out.trim();
  while (out.startsWith(".")) out.remove(0, 1);   // no hidden files or ".."
  if (out.length() > 64) {
    // Keep the extension; don't cut in the middle of a UTF-8 sequence
    unsigned int cut = 60;
    while (cut > 0 && ((uint8_t)out[cut] & 0xC0) == 0x80) cut--;
    out = out.substring(0, cut) + out.substring(out.length() - 4);
  }
  String lower = out; lower.toLowerCase();
  if (out.length() <= 4 || !lower.endsWith(".mp3")) return "";
  return out;
}

// ==========================================================================
//  Setup shared web endpoints (settings + OTA) — used in both modes
// ==========================================================================
// "HH:MM" → h, m (false if malformed or out of range)
static bool parseHHMM(const String &t, int &h, int &m) {
  int colon = t.indexOf(':');
  if (colon <= 0) return false;
  h = t.substring(0, colon).toInt();
  m = t.substring(colon + 1).toInt();
  return h >= 0 && h <= 23 && m >= 0 && m <= 59;
}

// Schedule status line for the web page
String schedStatus() {
  char nb[12]; nextAlarmStr(nb, sizeof(nb));
  if (!strcmp(nb, "--:--")) return "No alarm scheduled";
  String st = "Next: " + String(nb);
  if (skipTarget) {
    struct tm lt; localtime_r(&skipTarget, &lt);
    st += " (" + String(dayNames[lt.tm_wday]) + " skipped)";
  }
  return st;
}

void setupSettingsEndpoints()
{
  #define WEB_GUARD() if (!webEnabled) { r->send(403, "text/plain", "Web interface disabled"); return; }

  if (!uploadMutex) uploadMutex = xSemaphoreCreateMutex();

  server.on("/settings", HTTP_GET, [](AsyncWebServerRequest *r) {
    WEB_GUARD();
    r->send(200, "text/html", settingsPage());
  });

  server.on("/saveLocation", HTTP_POST, [](AsyncWebServerRequest *r) {
    WEB_GUARD();
    // Missing optional fields read as "" (getParam() returns NULL for them)
    auto postParam = [r](const char *name) -> String {
      const AsyncWebParameter *p = r->getParam(name, true);
      return p ? p->value() : String();
    };
    float lat = postParam("lat").toFloat();
    float lon = postParam("lon").toFloat();
    if (r->hasParam("lat", true) && r->hasParam("lon", true) &&
        lat >= -90.0f && lat <= 90.0f && lon >= -180.0f && lon <= 180.0f) {
      cfgLat     = lat;
      cfgLon     = lon;
      cfgTzName  = postParam("tz");
      cfgCity    = postParam("city");
      cfgCountry = postParam("country");

      if (cfgTzName.length() == 0) cfgTzName = "auto";

      saveLocationSettings();

      // Apply new timezone and fetch weather from the main loop — a blocking
      // HTTPS request here would stall the AsyncTCP task (watchdog reset)
      reqLocationApply = true;

      String body = "<p>" + htmlAttrEscape(cfgCity) + ", " + htmlAttrEscape(cfgCountry) + "</p>";
      body += "<p class='muted'>" + String(cfgLat, 4) + ", " + String(cfgLon, 4) + "</p>";
      body += "<a class='btn btnBlue' href='/'>Back</a>";
      String h = msgPage("Location Saved", "#28a745", body);
      r->send(200, "text/html", h);
    } else {
      r->send(400, "text/plain", "Missing or invalid lat/lon");
    }
  });

  server.on("/brightness", HTTP_GET, [](AsyncWebServerRequest *r) {
    WEB_GUARD();
    if (r->hasParam("v")) {
      int v = r->getParam("v")->value().toInt();
      if (v < 1) v = 1;
      if (v > 255) v = 255;
      cfgBrightness = v;
      applyBrightness();
      saveLocationSettings();
      r->send(200, "text/plain", "OK");
    } else {
      r->send(200, "text/plain", String(cfgBrightness));
    }
  });

  // Alarm set
  server.on("/alarm/set", HTTP_GET, [](AsyncWebServerRequest *r) {
    WEB_GUARD();
    int h, m;
    if (r->hasParam("time") && parseHHMM(r->getParam("time")->value(), h, m)) {
      alarmHour = h;
      alarmMinute = m;
    }
    if (r->hasParam("on")) {
      alarmEnabled = r->getParam("on")->value().toInt() == 1;
    }
    if (r->hasParam("sound")) {
      String newSound = r->getParam("sound")->value();
      // Only accept a file we actually have. "" (placeholder option when there
      // is no SD card / no files) is ignored so the saved tune isn't wiped.
      bool known = false;
      for (int i = 0; i < mp3FileCount && !known; i++) known = (mp3Files[i] == newSound);
      if (known && newSound != alarmSound) {
        alarmSound = newSound;
        // Stop test if playing a different song now (handled by main loop)
        if (testPlaying) audioReqTestStop = true;
      }
    }
    if (r->hasParam("vol")) {
      alarmVolume = r->getParam("vol")->value().toInt();
      if (alarmVolume < 0) alarmVolume = 0;
      if (alarmVolume > 100) alarmVolume = 100;
      audioReqVolume = true;
    }
    saveAlarmSettings();
    uiReqAlarmLabel = true;  // refresh label from main loop (LVGL not safe from async)
    r->send(200, "text/plain", "OK");
  });

  // Weekly schedule: en=0|1, or d=0..6 (0 = Sunday) with on, time=HH:MM, sound ("" = default tune)
  server.on("/alarm/sched", HTTP_GET, [](AsyncWebServerRequest *r) {
    WEB_GUARD();
    if (r->hasParam("en")) {
      bool en = r->getParam("en")->value().toInt() == 1;
      if (en && !schedStored) {  // first use: start from the current alarm, all days inactive
        for (int d = 0; d < 7; d++) {
          sched[d] = { 0, (uint8_t)alarmHour, (uint8_t)alarmMinute };
          schedSound[d] = "";
        }
      }
      schedEnabled = en;
      logMsg("Schedule %s\n", en ? "on" : "off");
    }
    int d = r->hasParam("d") ? r->getParam("d")->value().toInt() : -1;
    if (d >= 0 && d < 7) {
      int h, m;
      if (r->hasParam("on")) sched[d].on = r->getParam("on")->value().toInt() == 1;
      if (r->hasParam("time") && parseHHMM(r->getParam("time")->value(), h, m)) {
        sched[d].hour = h;
        sched[d].min = m;
      }
      if (r->hasParam("sound")) {
        String snd = r->getParam("sound")->value();
        bool known = snd.length() == 0;  // "" = default tune
        for (int i = 0; i < mp3FileCount && !known; i++) known = (mp3Files[i] == snd);
        if (known) schedSound[d] = snd;
      }
      logMsg("Schedule %s: %s %02d:%02d %s\n", dayNames[d], sched[d].on ? "on" : "off",
             sched[d].hour, sched[d].min, schedSound[d].length() ? schedSound[d].c_str() : "(default)");
    }
    schedDropStaleSkip();
    saveSchedule();
    uiReqAlarmLabel = true;
    r->send(200, "text/plain", schedStatus());
  });

  // Alarm volume (live preview)
  server.on("/alarm/volume", HTTP_GET, [](AsyncWebServerRequest *r) {
    WEB_GUARD();
    if (r->hasParam("v")) {
      alarmVolume = r->getParam("v")->value().toInt();
      if (alarmVolume < 0) alarmVolume = 0;
      if (alarmVolume > 100) alarmVolume = 100;
      audioReqVolume = true;
      saveAlarmSettings();
    }
    r->send(200, "text/plain", String(alarmVolume));
  });

  // Alarm test play/stop toggle
  server.on("/alarm/test", HTTP_GET, [](AsyncWebServerRequest *r) {
    WEB_GUARD();
    if (testPlaying) {
      audioReqTestStop = true;
      r->send(200, "text/plain", "stopped");
    } else {
      audioReqTestStart = true;
      r->send(200, "text/plain", "playing");
    }
  });

  // Alarm test status (for polling)
  server.on("/alarm/testStatus", HTTP_GET, [](AsyncWebServerRequest *r) {
    WEB_GUARD();
    r->send(200, "text/plain", testPlaying ? "playing" : "stopped");
  });

  // Alarm dismiss
  server.on("/alarm/dismiss", HTTP_GET, [](AsyncWebServerRequest *r) {
    WEB_GUARD();
    audioReqDismiss = true;
    r->send(200, "text/plain", "OK");
  });

  // File manager page
  server.on("/files", HTTP_GET, [](AsyncWebServerRequest *r) {
    WEB_GUARD();
    r->send(200, "text/html", fileManagerPage());
  });

  // File download — separate path to avoid /files route conflict
  server.on("/dl", HTTP_GET, [](AsyncWebServerRequest *r) {
    WEB_GUARD();
    if (!sdCardOk) { r->send(500, "text/plain", "No SD card"); return; }
    if (!r->hasParam("f")) { r->send(400, "text/plain", "Missing filename"); return; }
    String fname = r->getParam("f")->value();
    if (!fname.startsWith("/")) fname = "/" + fname;
    logMsg("Download request: [%s]\n", fname.c_str());
    if (!SD.exists(fname.c_str())) { r->send(404, "text/plain", "File not found"); return; }
    // The library owns the File and closes it when the response ends or the
    // client disconnects (the old hand-rolled chunked reader leaked a handle
    // per cancelled download; SD allows only 5 open files). Also sets a proper
    // Content-Length and Content-Disposition.
    r->send(r->beginResponse(SD, fname, "audio/mpeg", true));
  });

  // File upload — chunked binary via JS, received by body handler (4th param).
  // We use custom chunking instead of multipart because ESPAsyncWebServer's
  // multipart handler has heap issues with large (5MB+) files on ESP32.
  // Each request carries one chunk (<= UPLOAD_BUF_SIZE) plus X-Filename,
  // X-Offset and X-Total headers. TCP delivers ~974 byte fragments; we buffer
  // them in RAM and write the chunk to SD in one go. The file handle stays open
  // across chunks; loop() skips display/SD work while uploadInProgress, and its
  // idle watchdog aborts the upload if the client disappears.
  server.on("/files/upload", HTTP_POST,
    // Response handler — fires after body is complete
    [](AsyncWebServerRequest *r) {
      WEB_GUARD();
      if (!sdCardOk) { r->send(500, "text/plain", "No SD card"); return; }
      if (r->contentLength() == 0) { r->send(400, "text/plain", "Empty chunk"); return; }
      xSemaphoreTake(uploadMutex, portMAX_DELAY);
      int st = uploadStatus;
      const char *msg = uploadStatusMsg;
      xSemaphoreGive(uploadMutex);
      r->send(st, "text/plain", msg);
    },
    NULL,  // no multipart handler
    // Body handler — receives raw binary POST body
    [](AsyncWebServerRequest *r, uint8_t *data, size_t len, size_t index, size_t total) {
      if (!webEnabled || !sdCardOk) return;  // response handler reports the error
      xSemaphoreTake(uploadMutex, portMAX_DELAY);
      uploadLastActivity = millis();

      // First callback of each HTTP request: validate headers, open/resume the file
      if (index == 0) {
        uploadStatus = 200;
        uploadStatusMsg = "OK";
        uploadChunkSkip = false;
        uploadBufPos = 0;

        String fname = sanitizeUploadName(r->hasHeader("X-Filename") ? r->getHeader("X-Filename")->value() : "");
        size_t offset    = r->hasHeader("X-Offset") ? r->getHeader("X-Offset")->value().toInt() : 0;
        size_t fileTotal = r->hasHeader("X-Total")  ? r->getHeader("X-Total")->value().toInt()  : 0;
        String path = "/" + fname;

        if (fname.length() == 0) {
          uploadFailLocked(400, "Invalid filename (must be .mp3)", false);
        } else if (total > UPLOAD_BUF_SIZE) {
          uploadFailLocked(413, "Chunk too large", false);
        } else if (offset == 0 && audioPlaying && path == playingFile) {
          uploadFailLocked(409, "This file is playing - stop playback first", false);
        } else if (offset == 0) {
          // New upload — discard any stale one (client restarted or gave up)
          if (uploadInProgress) uploadCleanupLocked(true, "superseded");
          uploadBuf = (uint8_t *)malloc(UPLOAD_BUF_SIZE);
          if (!uploadBuf) {
            uploadFailLocked(500, "Out of memory", false);
          } else {
            uploadFilename = path;
            uploadExpectedTotal = fileTotal;
            uploadBytesWritten = 0;
            uploadLastDoneName = "";
            uploadInProgress = true;
            logMsg("Upload start: %s (%u bytes expected)\n", path.c_str(), fileTotal);
            uploadFile = SD.open(path, FILE_WRITE);
            if (!uploadFile) uploadFailLocked(500, "Cannot create file", true);
          }
        } else if (!uploadInProgress) {
          if (path == uploadLastDoneName && offset + total == uploadLastDoneSize) {
            uploadChunkSkip = true;  // final chunk resent after we already finished
          } else {
            uploadFailLocked(409, "No upload in progress", false);
          }
        } else if (path != uploadFilename) {
          uploadFailLocked(409, "Another upload is in progress", false);
        } else if (offset < uploadBytesWritten) {
          // Client missed our reply and resent a chunk we already wrote
          if (offset + total == uploadBytesWritten) uploadChunkSkip = true;
          else uploadFailLocked(409, "Chunk offset mismatch", true);
        } else if (offset > uploadBytesWritten) {
          uploadFailLocked(409, "Missing data before this chunk", true);
        }
      }

      if (uploadStatus != 200 || uploadChunkSkip || !uploadInProgress) {
        xSemaphoreGive(uploadMutex);
        return;
      }

      // Accumulate data into RAM buffer
      if (uploadBufPos + len > UPLOAD_BUF_SIZE) {
        uploadFailLocked(413, "Chunk too large", true);
        xSemaphoreGive(uploadMutex);
        return;
      }
      memcpy(uploadBuf + uploadBufPos, data, len);
      uploadBufPos += len;

      // Last TCP fragment for this HTTP request — write entire buffer to SD at once
      if ((index + len) == total) {
        size_t written = uploadFile.write(uploadBuf, uploadBufPos);
        if (written != uploadBufPos) {
          logMsg("Upload: SD write %u/%u\n", written, uploadBufPos);
          uploadFailLocked(500, "SD write error", true);
          xSemaphoreGive(uploadMutex);
          return;
        }
        uploadBytesWritten += written;
        uploadBufPos = 0;
        uploadFile.flush();

        // Final chunk of the whole file?
        if (uploadBytesWritten >= uploadExpectedTotal) {
          uploadFile.close();
          uploadFile = File();

          // Read back actual file size to verify
          File check = SD.open(uploadFilename, FILE_READ);
          size_t actualSize = 0;
          if (check) { actualSize = check.size(); check.close(); }
          logMsg("Upload done: %s wrote=%u expect=%u ondisk=%u\n",
                 uploadFilename.c_str(), uploadBytesWritten, uploadExpectedTotal, actualSize);

          uploadLastDoneName = uploadFilename;
          uploadLastDoneSize = uploadBytesWritten;
          uploadCleanupLocked(false, NULL);
          reqRescanMP3 = true;
        }
      }
      xSemaphoreGive(uploadMutex);
    }
  );

  // Abort an upload (client gave up) — closes and deletes the partial file
  server.on("/files/upload_abort", HTTP_POST, [](AsyncWebServerRequest *r) {
    WEB_GUARD();
    xSemaphoreTake(uploadMutex, portMAX_DELAY);
    if (uploadInProgress) uploadCleanupLocked(true, "client abort");
    xSemaphoreGive(uploadMutex);
    reqRescanMP3 = true;
    r->send(200, "text/plain", "OK");
  });

  // File delete
  server.on("/files/delete", HTTP_POST, [](AsyncWebServerRequest *r) {
    WEB_GUARD();
    if (!sdCardOk) { r->send(500, "text/plain", "No SD card"); return; }
    if (!r->hasParam("f", true)) { r->send(400, "text/plain", "Missing filename"); return; }
    String fname = r->getParam("f", true)->value();
    // Ensure leading slash
    if (!fname.startsWith("/")) fname = "/" + fname;
    logMsg("Delete request: [%s]\n", fname.c_str());
    if (audioPlaying && fname == playingFile) {
      r->send(409, "text/plain", "This file is playing - stop playback first");
      return;
    }
    if (SD.exists(fname.c_str())) {
      // If deleting the active alarm sound, clear it
      if (fname == alarmSound) {
        alarmSound = "";
        saveAlarmSettings();
      }
      bool schedChanged = false;  // days using this file fall back to the default tune
      for (int d = 0; d < 7; d++)
        if (schedSound[d] == fname) { schedSound[d] = ""; schedChanged = true; }
      if (schedChanged) saveSchedule();
      if (SD.remove(fname.c_str())) {
        reqRescanMP3 = true;  // rescan in the main loop (mp3Files[] isn't thread-safe)
        logMsg("Deleted OK: %s\n", fname.c_str());
        r->send(200, "text/plain", "OK");
      } else {
        logMsg("SD.remove failed: %s\n", fname.c_str());
        r->send(500, "text/plain", "Delete failed");
      }
    } else {
      logMsg("File not found: %s\n", fname.c_str());
      r->send(404, "text/plain", "File not found: " + fname);
    }
  });

  // Wipe all files from the SD card root
  server.on("/files/wipe", HTTP_POST, [](AsyncWebServerRequest *r) {
    WEB_GUARD();
    if (!sdCardOk) { r->send(500, "text/plain", "No SD card"); return; }
    logMsg("Wipe SD card requested\n");
    if (audioPlaying) { r->send(409, "text/plain", "Audio is playing - stop playback first"); return; }
    int deleted = 0, failed = 0;
    File root = SD.open("/");
    if (!root) { r->send(500, "text/plain", "Cannot open SD root"); return; }
    // Collect filenames first (deleting while iterating can cause issues)
    String toDelete[64];
    int count = 0;
    File entry = root.openNextFile();
    while (entry && count < 64) {
      if (!entry.isDirectory()) {
        String name = String(entry.name());
        if (!name.startsWith("/")) name = "/" + name;
        toDelete[count++] = name;
      }
      entry = root.openNextFile();
    }
    root.close();
    // Now delete them
    for (int i = 0; i < count; i++) {
      if (SD.remove(toDelete[i].c_str())) {
        logMsg("Wiped: %s\n", toDelete[i].c_str());
        deleted++;
      } else {
        logMsg("Wipe failed: %s\n", toDelete[i].c_str());
        failed++;
      }
    }
    // Clear alarm sound since all files are gone
    alarmSound = "";
    saveAlarmSettings();
    for (int d = 0; d < 7; d++) schedSound[d] = "";
    saveSchedule();
    reqRescanMP3 = true;
    String msg = "Deleted " + String(deleted) + " files";
    if (failed > 0) msg += ", " + String(failed) + " failed";
    r->send(200, "text/plain", msg);
  });

  // Factory reset page
  server.on("/factory", HTTP_GET, [](AsyncWebServerRequest *r) {
    WEB_GUARD();
    String html = pageHead("Factory Reset");
    html.reserve(6500);
    html += PAGE_BODY "<h2 style='color:#e74c3c;'>Factory Reset</h2>";
    html += "<div class='card warn'><b style='color:#ff6b6b;'>This permanently erases everything:</b>";
    html += "<ul style='color:#ccc;font-size:14px;line-height:1.7;padding-left:20px;margin:10px 0;'>";
    html += "<li>All MP3 files on the SD card</li><li>Alarm, weekly schedule, sound, volume and snooze settings</li>";
    html += "<li>Location, timezone and brightness settings</li><li>WiFi network credentials</li></ul>";
    html += "<small style='color:#ff6b6b;'>The clock reboots into setup (AP) mode. There is no undo and no backup.</small>";
    html += "<p class='status' id='status'></p>";
    html += "<button class='btnClear' id='resetBtn' onclick='doReset()'>Factory Reset</button></div>";
    html += "<a class='back' href='/'>&#8249; Back to Clock</a>";
    html += "</div>";
    html += "<script>";
    html += "function doReset(){";
    html += "  if(!confirm('Are you sure you want to factory reset this device?\\n\\nAll files, settings, and WiFi credentials will be permanently erased.'))return;";
    html += "  if(!confirm('Last chance - this cannot be undone.\\n\\nThe device will reboot into setup mode.'))return;";
    html += "  var btn=document.getElementById('resetBtn');";
    html += "  var stat=document.getElementById('status');";
    html += "  btn.disabled=true;btn.textContent='Resetting...';";
    html += "  stat.textContent='Erasing all data...';stat.style.color='#c0392b';";
    html += "  var xhr=new XMLHttpRequest();";
    html += "  xhr.open('POST','/factory/confirm',true);";
    html += "  xhr.onload=function(){";
    html += "    stat.textContent='Device is rebooting into setup mode...';stat.style.color='#FFcc44';";
    html += "    btn.textContent='Rebooting...';";
    html += "  };";
    html += "  xhr.onerror=function(){";
    html += "    stat.textContent='Device is rebooting into setup mode...';stat.style.color='#FFcc44';";
    html += "    btn.textContent='Rebooting...';";
    html += "  };";
    html += "  xhr.send();";
    html += "}";
    html += "</script>";
    html += "</body></html>";
    r->send(200, "text/html", html);
  });

  // Factory reset confirm — wipes everything and reboots
  server.on("/factory/confirm", HTTP_POST, [](AsyncWebServerRequest *r) {
    WEB_GUARD();
    logMsg("FACTORY RESET initiated\n");

    // 1. Wipe all files on SD card
    if (sdCardOk) {
      File root = SD.open("/");
      if (root) {
        String toDelete[64];
        int count = 0;
        File entry = root.openNextFile();
        while (entry && count < 64) {
          if (!entry.isDirectory()) {
            String name = String(entry.name());
            if (!name.startsWith("/")) name = "/" + name;
            toDelete[count++] = name;
          }
          entry = root.openNextFile();
        }
        root.close();
        for (int i = 0; i < count; i++) {
          SD.remove(toDelete[i].c_str());
          logMsg("Factory wipe: %s\n", toDelete[i].c_str());
        }
      }
    }

    // 2. Clear all preference namespaces
    prefs.begin("wifi", false); prefs.clear(); prefs.end();
    prefs.begin("loc", false); prefs.clear(); prefs.end();
    prefs.begin("alarm", false); prefs.clear(); prefs.end();
    logMsg("All preferences cleared\n");

    r->send(200, "text/plain", "OK");
    delay(1000);
    ESP.restart();
  });

  // Log viewer page
  server.on("/syslog", HTTP_GET, [](AsyncWebServerRequest *r) {
    WEB_GUARD();
    String html = pageHead("System Log");
    html += "pre{background:#0b0b0b;color:#8f8;border:1px solid #262626;border-radius:12px;padding:12px;font-size:11px;"
            "white-space:pre-wrap;word-wrap:break-word;max-height:70vh;overflow-y:auto;margin:0;}"
            ".box{max-width:600px;}";
    html += PAGE_BODY "<h2>System Log</h2><pre id='lp'>Loading...</pre>"
            "<div class='srow'><button class='btnBlue' onclick='fl()'>Refresh</button><button onclick='cl()'>Clear</button></div>"
            "<a class='back' href='/'>&#8249; Back to Clock</a></div>"
            "<script>"
            "function fl(){fetch('/syslog_data').then(function(r){return r.text();}).then(function(t){var p=document.getElementById('lp');p.textContent=t||'(empty)';p.scrollTop=p.scrollHeight;});}"
            "function cl(){fetch('/syslog_clear').then(function(){fl();});}"
            "fl();setInterval(fl,5000);"
            "</script></body></html>";
    r->send(200, "text/html", html);
  });

  server.on("/syslog_data", HTTP_GET, [](AsyncWebServerRequest *r) {
    WEB_GUARD();
    r->send(200, "text/plain", getLog());
  });

  server.on("/syslog_clear", HTTP_GET, [](AsyncWebServerRequest *r) {
    WEB_GUARD();
    clearLog();
    r->send(200, "text/plain", "OK");
  });
}

// ==========================================================================
//  Config Portal (AP mode)
// ==========================================================================
// forced = true when the user asked for setup (BOOT hold). Otherwise the portal
// is a fallback because saved WiFi was unreachable, and portalWifiRetry() keeps
// trying the saved network so the clock recovers on its own (e.g. after a power
// cut where the router boots slower than the clock).
void startConfigPortal(bool forced)
{
  portalForced = forced;
  bool canRetry = !forced && savedSSID.length() > 0;
  WiFi.mode(canRetry ? WIFI_AP_STA : WIFI_AP);
  const char *apName = "BedsideClock-SETUP";
  WiFi.softAP(apName);
  delay(300);
  IPAddress ip = WiFi.softAPIP();

  ui_set_status(canRetry ? "AP MODE (retrying WiFi)" : "AP MODE: OPEN PORTAL");
  ui_set_ip((String("SSID: ") + apName + "\nIP: " + ip.toString()).c_str());
  lv_update();

  scanNetworks();

  server.on("/", HTTP_GET, [](AsyncWebServerRequest *r) {
    r->send(200, "text/html", wifiConfigPage());
  });
  server.on("/save", HTTP_POST, [](AsyncWebServerRequest *r) {
    String ss, sm, pw;
    if (r->hasParam("ssid_select", true)) ss = r->getParam("ssid_select", true)->value();
    if (r->hasParam("ssid_manual", true)) sm = r->getParam("ssid_manual", true)->value();
    if (r->hasParam("pass", true))        pw = r->getParam("pass", true)->value();
    sm.trim(); ss.trim();
    String finalSSID = sm.length() ? sm : ss;
    if (finalSSID.length() == 0) {
      r->send(400, "text/html", msgPage("Missing SSID", "#e74c3c", "<a class='btn btnBlue' href='/'>Go back</a>"));
      return;
    }
    prefs.begin("wifi", false);
    prefs.putString("ssid", finalSSID);
    prefs.putString("pass", pw);
    prefs.end();
    r->send(200, "text/html", msgPage("Saved!", "#28a745", "<p>Rebooting...</p>"));
    delay(2000); ESP.restart();
  });
  server.on("/clear", HTTP_POST, [](AsyncWebServerRequest *r) {
    clearWiFiCredentials();
    r->send(200, "text/html", msgPage("WiFi Cleared", "#7cf", "<p>Rebooting...</p>"));
    delay(1500); ESP.restart();
  });

  setupSettingsEndpoints();
  setupOTAEndpoints();
  setupCaptiveProbeEndpoints();
  server.onNotFound([](AsyncWebServerRequest *r) { r->redirect("/"); });
  server.begin();

  dnsServer.start(53, "*", WiFi.softAPIP());
  captivePortalRunning = true;
}

// ==========================================================================
//  WiFi recovery
// ==========================================================================
// Fallback portal: periodically retry the saved network (only while nobody is
// connected to the AP) and reboot into clock mode once it is reachable again.
void portalWifiRetry()
{
  if (portalForced || savedSSID.length() == 0) return;
  static uint32_t lastTry = 0;
  static bool trying = false;

  if (trying) {
    if (WiFi.status() == WL_CONNECTED) {
      logMsg("Saved WiFi reachable again, restarting into clock mode\n");
      ui_set_status("WiFi found!");
      ui_set_ip("Restarting...");
      lv_update();
      delay(500);
      ESP.restart();
    }
    if (millis() - lastTry > WIFI_CONNECT_TIMEOUT_MS) {
      trying = false;
      WiFi.disconnect(false);  // stop the STA attempt, keep the AP up
    }
    return;
  }

  if (millis() - lastTry < PORTAL_WIFI_RETRY_MS) return;
  lastTry = millis();
  if (WiFi.softAPgetStationNum() > 0) return;  // someone is configuring — leave the AP alone
  logMsg("Portal: retrying saved WiFi '%s'\n", savedSSID.c_str());
  WiFi.begin(savedSSID.c_str(), savedPASS.c_str());
  trying = true;
}

// Clock mode: make sure we reconnect after a WiFi drop, and keep the IP label current.
void clockWifiKeepAlive()
{
  static uint32_t lastCheck = 0;
  static bool wasConnected = true;
  bool connected = (WiFi.status() == WL_CONNECTED);

  if (connected && !wasConnected) {
    logMsg("WiFi reconnected: %s\n", WiFi.localIP().toString().c_str());
    if (label_status) lv_label_set_text(label_status, WiFi.localIP().toString().c_str());
  }
  wasConnected = connected;

  if (connected || millis() - lastCheck < WIFI_KEEPALIVE_MS) return;
  lastCheck = millis();
  logMsg("WiFi down, reconnecting\n");
  WiFi.reconnect();
}

// ==========================================================================
//  BOOT Hold Check
// ==========================================================================
bool checkBootHoldWithProgress()
{
  ui_show_boot_bar(true);
  lv_bar_set_value(boot_bar, 0, LV_ANIM_OFF);
  lv_update();

  uint32_t start = millis();
  while (millis() - start < FORCE_PORTAL_HOLD_MS) {
    if (digitalRead(BOOT_BTN_PIN) == HIGH) {
      lv_bar_set_value(boot_bar, 0, LV_ANIM_OFF);
      ui_show_boot_bar(false); lv_update();
      return false;
    }
    int pct = (int)((millis() - start) * 100UL / FORCE_PORTAL_HOLD_MS);
    lv_bar_set_value(boot_bar, min(pct, 100), LV_ANIM_OFF);
    lv_update(); delay(10);
  }
  lv_bar_set_value(boot_bar, 100, LV_ANIM_OFF);
  lv_update(); delay(200);
  ui_show_boot_bar(false); lv_update();
  return true;
}

// ==========================================================================
//  SETUP
// ==========================================================================
void setup()
{
  Serial.begin(115200);
  logMsg("\n\nBedside Clock v%s\n", FW_VERSION);
  bootGuardCheck();  // first: roll back if this firmware keeps crashing
  delay(200);

  pinMode(BOOT_BTN_PIN, INPUT_PULLUP);
  pinMode(ENC_CLK, INPUT_PULLUP);
  pinMode(ENC_DT, INPUT_PULLUP);
  pinMode(ENC_SW, INPUT_PULLUP);

  // Init encoder state and attach interrupts for reliable quadrature decode
  encState = (digitalRead(ENC_CLK) ? 1 : 0) | (digitalRead(ENC_DT) ? 2 : 0);
  attachInterrupt(digitalPinToInterrupt(ENC_CLK), encoderISR, CHANGE);
  attachInterrupt(digitalPinToInterrupt(ENC_DT),  encoderISR, CHANGE);

  // ---- Display init ----
  pinMode(LCD_BL, OUTPUT);
  analogWrite(LCD_BL, 255);  // full brightness until settings load
  gfx->begin();
  gfx->fillScreen(0x0000);

  // ---- LVGL init ----
  lv_init();

  uint32_t bufSize = (uint32_t)gfx->width() * 40;
  disp_draw_buf = (lv_color_t *)heap_caps_malloc(bufSize * sizeof(lv_color_t), MALLOC_CAP_INTERNAL | MALLOC_CAP_8BIT);
  if (!disp_draw_buf)
    disp_draw_buf = (lv_color_t *)heap_caps_malloc(bufSize * sizeof(lv_color_t), MALLOC_CAP_8BIT);
  if (!disp_draw_buf) { logMsg("LVGL buf alloc failed!\n"); while (1) delay(1000); }

  lv_disp_draw_buf_init(&draw_buf, disp_draw_buf, NULL, bufSize);

  static lv_disp_drv_t disp_drv;
  lv_disp_drv_init(&disp_drv);
  disp_drv.hor_res  = gfx->width();
  disp_drv.ver_res  = gfx->height();
  disp_drv.flush_cb = my_disp_flush;
  disp_drv.draw_buf = &draw_buf;
  lv_disp_drv_register(&disp_drv);

  logMsg("Display: %d x %d\n", gfx->width(), gfx->height());

  // Force dark
  lv_obj_set_style_bg_color(lv_scr_act(), lv_color_black(), 0);
  lv_obj_set_style_bg_opa(lv_scr_act(), LV_OPA_COVER, 0);
  lv_obj_set_style_text_color(lv_scr_act(), lv_color_white(), 0);

  build_portal_ui();

  // Load saved location settings
  loadLocationSettings();
  applyBrightness();

  // Load alarm settings
  loadAlarmSettings();

  // Init SD card and audio
  initSDCard();
  initAudio();

  ui_set_status("Hold BOOT for Setup");
  ui_set_ip("Release to boot normal");
  lv_update();
  delay(150);

  // Setup portal requested by a BOOT hold in clock mode? (one-shot flag)
  prefs.begin("boot", false);
  bool portalRequested = prefs.getBool("portal", false);
  if (portalRequested) prefs.remove("portal");
  prefs.end();

  // Check BOOT button hold
  if (portalRequested || digitalRead(BOOT_BTN_PIN) == LOW) {
    if (portalRequested || checkBootHoldWithProgress()) {
      ui_set_status("FORCED SETUP MODE");
      ui_set_ip("Starting portal...");
      lv_update(); delay(400);
      startConfigPortal(true);
      return;
    }
  }

  // Normal boot — try WiFi
  ui_set_status("Loading WiFi...");
  ui_set_ip(""); lv_update();

  loadSavedWiFi();

  if (savedSSID.length() > 0) {
    ui_set_status("Connecting WiFi...");
    ui_set_ip(savedSSID.c_str()); lv_update();

    if (connectToWiFi(savedSSID.c_str(), savedPASS.c_str(), WIFI_CONNECT_TIMEOUT_MS)) {
      logMsg("WiFi connected, starting clock mode\n");

      // Apply timezone and sync NTP
      applyTimezone();

      ui_set_status("Syncing time...");
      lv_update();
      delay(1500);

      // Build clock UI
      build_clock_ui();
      clockMode = true;

      // Initial weather fetch
      fetchWeather();
      update_weather_display();
      updateAlarmLabel();

      if (label_status) {
        lv_label_set_text(label_status, WiFi.localIP().toString().c_str());
      }

      // Start web server (clock mode — settings + OTA)
      server.on("/", HTTP_GET, [](AsyncWebServerRequest *r) {
        if (!webEnabled) { r->send(403, "text/plain", "Web interface disabled"); return; }
        r->send(200, "text/html", clockHomePage());
      });
      setupSettingsEndpoints();
      setupOTAEndpoints();
      server.onNotFound([](AsyncWebServerRequest *r) { r->redirect("/"); });
      server.begin();

      return;
    } else {
      ui_set_status("WiFi Failed!");
      ui_set_ip("Starting setup AP, will keep retrying");
      lv_update(); delay(1000);
    }
  }

  startConfigPortal(false);
}

// ==========================================================================
//  LOOP
// ==========================================================================
void loop()
{
  bootGuardMarkHealthy();

  // During file upload, skip ALL display and SD activity to keep SPI bus free
  if (uploadInProgress) {
    uploadIdleWatchdog();  // abort if the client went away, so the clock can't freeze
    delay(1);
    return;
  }

  // Deferred SD rescan requested by async web handlers
  if (reqRescanMP3) {
    reqRescanMP3 = false;
    rescanMP3Files();
  }

  lv_timer_handler();

  if (captivePortalRunning) {
    dnsServer.processNextRequest();
    portalWifiRetry();
  }

  if (clockMode) {
    // Read encoder every loop (must be fast for reliable reading)
    readEncoder();

    // Alarm went off while the menu was open: close it so the next tap snoozes
    if (menuActive && alarmFiring) menuClose();

    // Menu handling
    if (menuActive) {
      menuHandleInput();
      // Don't update clock display while menu is open
    } else {
      update_clock_display();
      consumeEncoderDelta();  // rotation does nothing here — don't let it pile up for the menu

      // Refresh the snooze countdown a few times per second (not every loop)
      static uint32_t lastSnoozeLabel = 0;
      if (alarmSnoozing && millis() - lastSnoozeLabel >= 250) {
        lastSnoozeLabel = millis();
        updateAlarmLabel();
      }

      // Encoder short-press: snooze if ringing, otherwise ignore.
      // Always consume the press — a tap during snooze must not stay latched,
      // or it would instantly re-snooze the alarm when the snooze ends.
      bool shortPress = encoderShortPress();
      if (shortPress && alarmFiring) {
        snoozeAlarm();
      }

      // Encoder long-press: dismiss alarm/snooze if active, open menu if not
      if (encoderLongPress()) {
        if (alarmFiring || alarmSnoozing) {
          dismissAlarm();
        } else {
          menuOpen();
        }
      }
    }

    // Audio processing (always runs — also handles async web commands)
    loopAudio();

    // Handle deferred UI updates from async web handlers
    if (uiReqAlarmLabel) {
      uiReqAlarmLabel = false;
      updateAlarmLabel();
    }

    // New location saved from the web — apply TZ and refresh weather here,
    // not in the AsyncTCP task (blocking HTTPS + LVGL are unsafe there)
    if (reqLocationApply && !alarmFiring && !audioPlaying) {
      reqLocationApply = false;
      applyTimezone();
      fetchWeather();
      update_weather_display();
    }

    clockWifiKeepAlive();

    // Check alarm trigger
    checkAlarm();

    // Check snooze expiry
    checkSnooze();

    // Periodic weather refresh. fetchWeather() blocks for seconds, so never run
    // it while the alarm rings or audio plays (the 2 KB audio buffer would run
    // dry and button presses would be missed) — it runs once playback stops.
    if (!alarmFiring && !audioPlaying && millis() - lastWeatherFetch > WEATHER_INTERVAL_MS) {
      fetchWeather();
      update_weather_display();
    }

    // Check BOOT button for re-entering setup
    static bool bootHeld = false;
    static uint32_t bootStart = 0;
    if (digitalRead(BOOT_BTN_PIN) == LOW) {
      if (!bootHeld) {
        bootHeld = true;
        bootStart = millis();
        ui_show_boot_bar(true);
      }
      uint32_t held = millis() - bootStart;
      int pct = (int)(held * 100UL / FORCE_PORTAL_HOLD_MS);
      lv_bar_set_value(boot_bar, min(pct, 100), LV_ANIM_OFF);

      if (held >= FORCE_PORTAL_HOLD_MS) {
        // Reboot straight into the setup portal (no need to keep holding)
        prefs.begin("boot", false);
        prefs.putBool("portal", true);
        prefs.end();
        ESP.restart();
      }
    } else {
      if (bootHeld) {
        bootHeld = false;
        lv_bar_set_value(boot_bar, 0, LV_ANIM_OFF);
        ui_show_boot_bar(false);
      }
    }
  }

  delay(5);
}
